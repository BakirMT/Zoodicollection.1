rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Authorization helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        (exists(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admin_profiles/$(request.auth.uid)).data.isActive == true)
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public catalog collections & real-time store sync
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    
    match /sub_categories/{subId} {
      allow read, write: if true;
    }
    
    match /sub_sub_categories/{subSubId} {
      allow read, write: if true;
    }

    match /products/{productId} {
      allow read, write: if true;
    }
    
    match /homepage_sections/{sectionId} {
      allow read, write: if true;
    }
    
    match /coupons/{couponCode} {
      allow read, write: if true;
    }

    match /category_spec_templates/{templateId} {
      allow read, write: if true;
    }

    match /_system_metadata/{metaId} {
      allow read, write: if true;
    }

    // Customer Private Collections
    match /customer_profiles/{userId} {
      allow read, write: if true;
    }
    
    match /carts/{userId} {
      allow read, write: if true;
    }
    
    match /wishlists/{userId} {
      allow read, write: if true;
    }

    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.customerId) || isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow read: if isOwner(resource.data.customerId) || isAdmin();
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.customerId) || isAdmin();
    }

    // Admin Profiles & Audit Logs
    match /admin_profiles/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }

    // PUSH NOTIFICATIONS & DEVICE TOKENS (Strict Security)
    match /notifications/{notifId} {
      // Customers read their own or public broadcasts; Admins read their operational alerts
      allow read: if (isAuthenticated() && (
        resource.data.recipientRole == 'all' ||
        resource.data.recipientRole == 'customer' ||
        resource.data.recipientUserId == request.auth.uid
      )) || (isAdmin() && (
        resource.data.recipientRole == 'admin' ||
        resource.data.recipientRole == 'all'
      ));
      // Only server-side triggers / Cloud Functions or authorized admins can create notification records
      allow create: if isAdmin();
      // Users can mark their notifications as read
      allow update: if (isAuthenticated() && (
        resource.data.recipientUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      )) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.recipientUserId == request.auth.uid) || isAdmin();
    }

    match /notification_campaigns/{campaignId} {
      allow read, write: if isAdmin();
    }

    match /device_tokens/{tokenId} {
      // User can only register/refresh their own device token
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    match /idempotency_keys/{keyId} {
      allow read, write: if false; // Cloud Functions Admin SDK only
    }
  }
}
